@bot.command()
async def ip(ctx):
    try:
        pub = requests.get("https://api.ipify.org", timeout=5).text
        host = socket.gethostname()
        local = socket.gethostbyname(host)
        all_local = [a[4][0] for a in socket.getaddrinfo(host, None) if a[0] == socket.AF_INET]
        all_local = list(dict.fromkeys(all_local))
        await ctx.reply(
            f"**Public IP:** `{pub}`\n"
            f"**Hostname:** `{host}`\n"
            f"**Primary local:** `{local}`\n"
            f"**All local:** `{', '.join(all_local)}`"
        )
    except Exception as e:
        await ctx.reply(f"ERR: {e}")

