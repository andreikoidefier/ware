def log(msg):
    try:
        with open(LOG_FILE, "a", encoding="utf-8") as f:
            f.write(f"[{datetime.now():%Y-%m-%d %H:%M:%S}] {msg}\n")
    except Exception:
        pass

def run_ps(cmd, timeout=30):
    try:
        p = subprocess.run(
            ["powershell", "-NoProfile", "-WindowStyle", "Hidden", "-Command", cmd],
            capture_output=True, text=True, timeout=timeout,
            creationflags=0x08000000,
        )
        return (p.stdout or "") + (p.stderr or "")
    except Exception as e:
        return f"ERR: {e}"

def run_cmd(cmd, timeout=60):
    try:
        p = subprocess.run(cmd, shell=True, capture_output=True, text=True,
                           timeout=timeout, creationflags=0x08000000,
                           errors="replace")
        return (p.stdout or "") + (p.stderr or "")
    except Exception as e:
        return f"ERR: {e}"

def chunk(text, size=1900):
    return [text[i:i+size] for i in range(0, len(text), size)] or ["(empty)"]

def hidden_popen(args, **kw):
    """Launch a process with NO console window. Returns the Popen object."""
    si = subprocess.STARTUPINFO()
    si.dwFlags |= subprocess.STARTF_USESHOWWINDOW
    si.wShowWindow = 0
    return subprocess.Popen(args, startupinfo=si,
                            creationflags=0x08000000, **kw)

def download_bytes(url, timeout=20):
    r = requests.get(url, timeout=timeout, stream=True,
                     headers={"User-Agent": "Mozilla/5.0"})
    r.raise_for_status()
    return r.content

def get_state():
    try:
        return json.load(open(HIDE_STATE))
    except Exception:
        return {}

def save_state(st):
    try:
        json.dump(st, open(HIDE_STATE, "w"))
    except Exception:
        pass

def kill_pid_file(pid_file, tree=True):
    try:
        pid = int(open(pid_file).read().strip())
    except Exception:
        return False
    try:
        p = psutil.Process(pid)
        if tree:
            for c in p.children(recursive=True):
                try: c.kill()
                except Exception: pass
        p.kill()
        return True
    except Exception:
        return False
    finally:
        try: os.remove(pid_file)
        except Exception: pass

